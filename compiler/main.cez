package main

extern func printf(fmt *i8, ...) i32
extern func puts(s *i8) i32

func main(argc int, argv **i8) int {
    puts("=== Cez Self-Hosted Compiler (Stage 1) ===")

    if argc < 2 {
        puts("Usage: cez-stage1 <source1.cez> [source2.cez ...] [-o <output>]")
        return 1
    }

    var output_bin *i8 = "a.out"
    var files_count int = 0

    // Allocate 64MB Arena for multi-file compilation
    arena_buf := malloc(64 * 1024 * 1024)
    var arena Arena
    arena.Init(arena_buf, 64 * 1024 * 1024)
    defer free(arena_buf)

    root := AllocNode(&arena, NODE_PROGRAM, 1, 1)
    var last_decl *Node = (*Node)(uintptr(0))

    var i int = 1
    for i < argc {
        arg := *(**i8)(uintptr(argv) + usize(i) * 8)
        if StrEq(arg, "-o") {
            if i + 1 < argc {
                output_bin = *(**i8)(uintptr(argv) + usize(i + 1) * 8)
                i += 2
                continue
            }
        }

        printf("[Cez] Loading: %s\n", arg)
        file := ReadFile(arg)
        if uintptr(file.data) == 0 {
            printf("[Cez Error] Could not read file '%s'\n", arg)
            return 1
        }

        var parser Parser
        parser.Init(file.data, file.size, &arena)
        file_ast := parser.ParseProgram()

        // Append file_ast declarations to root
        decl := file_ast.body
        for uintptr(decl) != 0 {
            next_decl := decl.next
            decl.next = (*Node)(uintptr(0))
            if uintptr(last_decl) == 0 {
                root.body = decl
            } else {
                last_decl.next = decl
            }
            last_decl = decl
            decl = next_decl
        }

        files_count += 1
        i += 1
    }

    if files_count == 0 {
        puts("[Cez Error] No input files specified")
        return 1
    }

    // Codegen to /tmp/stage1_out.ll
    temp_ll := "/tmp/stage1_out.ll"
    mode := "w"
    fp := fopen(temp_ll, mode)
    if uintptr(fp) == 0 {
        puts("[Cez Error] Could not open temporary LLVM IR file")
        return 1
    }

    printf("[Cez] Generating LLVM IR...\n")
    var codegen Codegen
    codegen.Init(fp)
    codegen.Generate(root)
    fclose(fp)

    // Invoke Clang
    cmd_buf := malloc(512)
    sprintf(cmd_buf, "clang -O2 %s -o %s", temp_ll, output_bin)
    printf("[Cez] Invoking backend linker: %s\n", (*i8)(uintptr(cmd_buf)))
    ret := Exec((*i8)(uintptr(cmd_buf)))
    free(cmd_buf)

    if ret == 0 {
        printf("[Cez Success] Successfully built '%s' via self-hosted compiler!\n", output_bin)
    } else {
        printf("[Cez Error] Backend linking failed with code %d\n", ret)
        return 1
    }

    return 0
}
