package main

// Token Kind Constants for Cez self-hosted compiler

const TOK_EOF        int = 0
const TOK_IDENT      int = 1
const TOK_INT        int = 2
const TOK_STRING     int = 3
const TOK_CHAR       int = 4

// Keywords
const TOK_PACKAGE    int = 10
const TOK_IMPORT     int = 11
const TOK_FUNC       int = 12
const TOK_TYPE       int = 13
const TOK_STRUCT     int = 14
const TOK_VAR        int = 15
const TOK_CONST      int = 16
const TOK_IF         int = 17
const TOK_ELSE       int = 18
const TOK_FOR        int = 19
const TOK_RETURN     int = 20
const TOK_DEFER      int = 21
const TOK_BREAK      int = 22
const TOK_CONTINUE   int = 23
const TOK_EXTERN     int = 24
const TOK_INLINE_ASM int = 25

// Attributes
const TOK_AT_PACKED  int = 30
const TOK_AT_NAKED   int = 31
const TOK_AT_ALIGN   int = 32
const TOK_AT_SECTION int = 33
const TOK_AT_EXPORT  int = 34

// Operators & Delimiters
const TOK_PLUS       int = 40 // +
const TOK_MINUS      int = 41 // -
const TOK_STAR       int = 42 // *
const TOK_SLASH      int = 43 // /
const TOK_PERCENT    int = 44 // %
const TOK_AMP        int = 45 // &
const TOK_PIPE       int = 46 // |
const TOK_CARET      int = 47 // ^
const TOK_SHL        int = 48 // <<
const TOK_SHR        int = 49 // >>

const TOK_ASSIGN     int = 50 // =
const TOK_COLON_ASSIGN int = 51 // :=
const TOK_PLUS_ASSIGN  int = 52 // +=
const TOK_MINUS_ASSIGN int = 53 // -=

const TOK_EQ         int = 60 // ==
const TOK_NOT_EQ     int = 61 // !=
const TOK_LT         int = 62 // <
const TOK_LT_EQ      int = 63 // <=
const TOK_GT         int = 64 // >
const TOK_GT_EQ      int = 65 // >=
const TOK_AND        int = 66 // &&
const TOK_OR         int = 67 // ||
const TOK_BANG       int = 68 // !

const TOK_LPAREN     int = 70 // (
const TOK_RPAREN     int = 71 // )
const TOK_LBRACKET   int = 72 // [
const TOK_RBRACKET   int = 73 // ]
const TOK_LBRACE     int = 74 // {
const TOK_RBRACE     int = 75 // }
const TOK_COMMA      int = 76 // ,
const TOK_DOT        int = 77 // .
const TOK_COLON      int = 78 // :
const TOK_SEMICOLON  int = 79 // ;
const TOK_ELLIPSIS   int = 80 // ...

type Token struct {
    kind    int
    line    int
    col     int
    int_val int
    str_val *i8
}
