package main

extern func printf(fmt *i8, ...) i32
extern func puts(s *i8) i32

// Network header: 16-bit magic, 8-bit version, 8-bit opcode, 32-bit payload_len
type PacketHeader struct @packed {
    magic       u16
    version     u8
    opcode      u8
    payload_len u32
}

func (h *PacketHeader) IsValid() bool {
    if h.magic != 0x5054 { // "PT"
        return false
    }
    if h.version != 1 {
        return false
    }
    return true
}

func (h *PacketHeader) Summary() {
    printf("Packet[magic=0x%04X, ver=%d, opcode=%d, payload_size=%u bytes]\n", 
           u32(h.magic), u32(h.version), u32(h.opcode), h.payload_len)
}

func main() int {
    puts("=== Cez Low-Level Server Packet Parser ===")

    var header PacketHeader = PacketHeader{
        magic: 0x5054,
        version: 1,
        opcode: 7,
        payload_len: 1024,
    }

    if header.IsValid() {
        puts("[OK] Header validation passed!")
        header.Summary()
    } else {
        puts("[ERR] Invalid packet header!")
        return 1
    }

    return 0
}
