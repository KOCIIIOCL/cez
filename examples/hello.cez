package main

extern func puts(s *i8) i32

func greet() {
    puts("  -> Inside greet function")
}

func main() int {
    defer puts("Deferred: execution completed cleanly!")
    defer greet()

    puts("Hello from Cez!")
    
    var a int = 20
    b := 22
    sum := a + b
    
    if sum == 42 {
        puts("Math check passed: 20 + 22 = 42")
    }

    return 0
}
