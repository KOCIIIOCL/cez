package main

extern func printf(fmt *i8, ...) i32

func compute(n int) int {
    var sum int = 0
    for i := 0; i < n; i += 1 {
        sum = (sum + i * 3) ^ (i >> 1)
    }
    return sum
}

func main() int {
    n := 500000000 // 500 million iterations
    res := compute(n)
    printf("Result: %ld\n", res)
    return 0
}
