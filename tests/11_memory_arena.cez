package main

extern func puts(s *i8) i32
extern func malloc(size int) *u8
extern func free(ptr *u8) void

type Arena struct {
    buffer   *u8
    capacity int
    offset   int
}

func (a *Arena) Init(buf *u8, cap int) {
    a.buffer = buf
    a.capacity = cap
    a.offset = 0
}

func (a *Arena) Alloc(size int) *u8 {
    // Align to 8 bytes
    aligned := ((a.offset + 7) / 8) * 8
    if aligned + size > a.capacity {
        return (*u8)(uintptr(0))
    }
    ptr := (*u8)(uintptr(a.buffer) + aligned)
    a.offset = aligned + size
    return ptr
}

func (a *Arena) Reset() {
    a.offset = 0
}

func (a *Arena) BytesUsed() int {
    return a.offset
}

type Node struct {
    val  int
    next *Node
}

func main() int {
    puts("=== Test 11: Memory Arena & Data Structures ===")

    raw_mem := malloc(1024)
    if uintptr(raw_mem) == 0 { return 1 }

    var arena Arena
    arena.Init(raw_mem, 1024)

    if arena.BytesUsed() != 0 { return 2 }

    // 1. Allocate a linked list of 5 nodes in the arena
    var head *Node = (*Node)(uintptr(0))
    for i := 1; i <= 5; i += 1 {
        mem := arena.Alloc(16) // sizeof(Node) is 16
        if uintptr(mem) == 0 { return 3 }
        node := (*Node)(uintptr(mem))
        node.val = i * 10
        node.next = head
        head = node
    }

    // List is: 50 -> 40 -> 30 -> 20 -> 10
    var sum int = 0
    var count int = 0
    curr := head
    for uintptr(curr) != 0 {
        sum += curr.val
        count += 1
        curr = curr.next
    }

    if count != 5 { return 4 }
    if sum != 150 { return 5 }
    if arena.BytesUsed() != 80 { return 6 } // 5 * 16 bytes = 80

    // 2. Reset arena and allocate again
    arena.Reset()
    if arena.BytesUsed() != 0 { return 7 }

    mem2 := arena.Alloc(64)
    if uintptr(mem2) == 0 { return 8 }
    // After reset, first allocation should start at offset 0
    if uintptr(mem2) != uintptr(raw_mem) { return 9 }
    if arena.BytesUsed() != 64 { return 10 }

    // 3. Test out of memory in arena
    overflow := arena.Alloc(2000) // exceeds remaining capacity
    if uintptr(overflow) != 0 { return 11 }

    free(raw_mem)

    puts("[PASS] Test 11: Memory Arena & Data Structures passed cleanly")
    return 0
}
