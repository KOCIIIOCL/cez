package main

extern func printf(fmt *i8, ...) i32
extern func malloc(size usize) *u8
extern func free(ptr *u8) void
extern func memset(ptr *u8, val i32, size usize) *u8

func sieve(limit int) int {
    flags := malloc(usize(limit + 1))
    if uintptr(flags) == 0 {
        return 0
    }
    memset(flags, 1, usize(limit + 1))
    flags[0] = u8(0)
    flags[1] = u8(0)
    
    for p := 2; p * p <= limit; p += 1 {
        if flags[p] != u8(0) {
            for i := p * p; i <= limit; i += p {
                flags[i] = u8(0)
            }
        }
    }
    
    count := 0
    for i := 2; i <= limit; i += 1 {
        if flags[i] != u8(0) {
            count += 1
        }
    }
    
    free(flags)
    return count
}

func main() int {
    total := 0
    for iter := 0; iter < 5; iter += 1 {
        total = sieve(10000000)
    }
    printf("%ld\n", total)
    return 0
}
